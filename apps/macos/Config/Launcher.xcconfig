// DBDSilicon: its own name, preferences, Keychain items and library folder (AppIdentity).
PRODUCT_NAME = DBDSilicon
PRODUCT_BUNDLE_IDENTIFIER = local.dbdsilicon
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1
INFOPLIST_KEY_CFBundleDisplayName = DBDSilicon
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.games
INFOPLIST_KEY_NSHumanReadableCopyright = Free software under the GNU GPL v3.

// Signed ad hoc, with no certificate: the app names no person, email or team, and anyone can build it without an
// Apple account. This overrides the project's Signing.xcconfig and Signing.local.xcconfig.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DISTRIBUTION_CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
OTHER_CODE_SIGN_FLAGS =
